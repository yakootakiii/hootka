node_modules/
dist/
coverage/

# Anchored to the functions package: a bare "lib/" also matches
# apps/web/src/lib/, which is source code.
/functions/lib/
.firebase/
*.local
.env
.env.*
!.env.example
.DS_Store
firebase-debug.log
firestore-debug.log
database-debug.log
ui-debug.log

# The emulator config is committed because it holds no secrets - only the demo-
# project the emulators accept without a login. It is ".env.development.local"
# so that it is loaded in dev and never in a production build.
!/.env.development.local

# Your real Firebase project settings. Fill this in and import it to Vercel.
# Never committed, even though it holds no secrets - it is per-deployment
# configuration, and committing it would let stale values override the ones
# set in the hosting dashboard.
/.env.production.local
