# Local development only.
#
# Vite loads ".env.development.local" in dev mode and NEVER in a production
# build, so the emulator flag below cannot leak into a deployed bundle. Do not
# rename this to ".env.local" - that file is loaded in every mode, including
# production builds on Vercel.
#
# The "demo-" project prefix is a Firebase convention: the emulators accept it
# without any login and it can never reach a real project. Nothing here is a
# secret. Real deploys get their values from the host's environment settings.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-hootka.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://demo-hootka.firebaseio.com
VITE_FIREBASE_PROJECT_ID=demo-hootka
VITE_FIREBASE_STORAGE_BUCKET=demo-hootka.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demohootka

VITE_USE_EMULATORS=true
