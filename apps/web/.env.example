# ---------------------------------------------------------------------------
# Hootka - reference list of every environment variable the app reads.
#
# This file is the committed template. Do not fill it in here - copy it to
# apps/web/.env.production.local (gitignored) and fill that in instead:
#
#   cp apps/web/.env.example apps/web/.env.production.local
#
# 1. Fill in the values there.
# 2. Vercel -> your project -> Settings -> Environment Variables -> Import,
#    and choose this file. Then redeploy: Vite bakes these into the JavaScript
#    at build time, so adding them alone changes nothing.
#
# This file is gitignored and never leaves your machine. Filling it in also
# lets you run a real production build locally with `npm run build`.
#
# None of these are secrets. They are shipped to every visitor's browser by
# design - Firebase security comes from the rules files in this repo, not from
# hiding the config.
#
# Where to find them:
#   Firebase console -> Project settings (the gear) -> Your apps
#   -> your web app -> SDK setup and configuration -> Config
# Each key below matches one field of that JavaScript object.
# ---------------------------------------------------------------------------

# apiKey - looks like "AIzaSy..."
VITE_FIREBASE_API_KEY=

# authDomain - "<project-id>.firebaseapp.com"
# Whatever domain you deploy to must also be listed under
# Authentication -> Settings -> Authorized domains, or the teacher's
# "Continue with Google" button fails. Players are unaffected.
VITE_FIREBASE_AUTH_DOMAIN=

# databaseURL - the Realtime Database, NOT Firestore. Must end in
# .firebaseio.com or .<region>.firebasedatabase.app
# If this key is missing from the console, create the Realtime Database first.
VITE_FIREBASE_DATABASE_URL=

# projectId
VITE_FIREBASE_PROJECT_ID=

# appId - looks like "1:123456789:web:abc123"
VITE_FIREBASE_APP_ID=

# storageBucket - only needed if you attach images to questions.
# Safe to leave empty otherwise.
VITE_FIREBASE_STORAGE_BUCKET=

# messagingSenderId - Hootka does not use messaging. Included only because the
# console shows it; safe to leave empty.
VITE_FIREBASE_MESSAGING_SENDER_ID=

# ---------------------------------------------------------------------------
# Do NOT add VITE_USE_EMULATORS here or in Vercel. It points the app at
# 127.0.0.1 and would make a deployed site unable to reach anything. Local
# development gets it from apps/web/.env.development.local instead.
# ---------------------------------------------------------------------------
