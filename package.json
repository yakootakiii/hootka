{
  "name": "hootka",
  "private": true,
  "version": "0.1.0",
  "description": "Hootka - a kid-friendly live quiz game",
  "workspaces": [
    "packages/core",
    "apps/web",
    "functions"
  ],
  "scripts": {
    "dev": "vite apps/web",
    "build": "npm run build:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p functions/tsconfig.json",
    "emulators": "npm run build:functions && firebase emulators:start",
    "loadtest": "tsx tests/load/simulate-players.ts",
    "e2e": "tsx tests/e2e/play-a-game.ts",
    "demo:open": "tsx scripts/demo-game.ts open",
    "demo:next": "tsx scripts/demo-game.ts advance",
    "build:web": "tsc --noEmit -p apps/web/tsconfig.json && vite build apps/web",
    "build:functions": "esbuild functions/src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=functions/lib/index.js --external:firebase-admin --external:firebase-functions --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "build:all": "npm run build:web && npm run build:functions"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
