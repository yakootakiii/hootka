{
  "name": "hootka",
  "private": true,
  "version": "0.1.0",
  "description": "Hootka - a kid-friendly live quiz game",
  "workspaces": [
    "packages/core",
    "apps/web"
  ],
  "scripts": {
    "dev": "vite apps/web",
    "build": "npm run build:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p tsconfig.api.json",
    "emulators": "firebase emulators:start",
    "loadtest": "tsx tests/load/simulate-players.ts",
    "e2e": "tsx tests/e2e/play-a-game.ts",
    "demo:open": "tsx scripts/demo-game.ts open",
    "demo:next": "tsx scripts/demo-game.ts advance",
    "build:web": "tsc --noEmit -p apps/web/tsconfig.json && vite build apps/web",
    "set-service-account": "node scripts/set-service-account.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vercel/node": "^13.0.1",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0"
  }
}
